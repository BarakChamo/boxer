{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "boxer hook claude-code", "timeout": 600 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "boxer hook claude-code", "timeout": 60 }] }
    ],
    "SubagentStart": [
      { "hooks": [{ "type": "command", "command": "boxer hook claude-code", "timeout": 600 }] }
    ],
    "SubagentStop": [
      { "hooks": [{ "type": "command", "command": "boxer hook claude-code", "timeout": 60 }] }
    ],
    "PreToolUse": [
      { "matcher": "Bash|Monitor", "hooks": [{ "type": "command", "command": "boxer hook claude-code", "timeout": 30 }] }
    ]
  }
}

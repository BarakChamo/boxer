{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "boxer hook dsh", "timeout": 120 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "boxer hook dsh", "timeout": 60 }] }
    ],
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "boxer hook dsh", "timeout": 30 }] }
    ]
  }
}

{
  "name": "boxer",
  "version": "[[.Version]]",
  "description": "Runs shell commands in a smolvm microVM keyed to the git worktree.",
  "contextFileName": "GEMINI.md",
  "mcpServers": {
    "boxer": {
      "command": "boxer",
      "args": ["mcp", "--harness", "gemini-cli"]
    }
  }[[if .ToolMode]],
  "excludeTools": ["run_shell_command"][[end]]
}
